# Copie este arquivo para .env quando for testar localmente.
# No Back4App, cadastre estes valores em Environment Variables.
# Não coloque o arquivo .env real no GitHub.

SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co

# Para o bot funcionar no servidor, use a chave service_role/secret do Supabase.
# A anon public key é pública, mas não é a melhor opção para o bot.
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_AQUI

# Senha para abrir a página do QR Code:
# https://seu-app.back4app.io/qr?key=SUA_SENHA
QR_PASSWORD=troque-essa-senha

BOT_NAME=RiftControl
PORT=3000

# Definir como true para ignorar mensagens fora de grupos
ONLY_GROUPS=false

# Número do dono (com DDI, ex: 5598999999999)
OWNER_NUMBER=

# ID do grupo permitido (obter com !idgrupo dentro do grupo)
ALLOWED_GROUP_ID=

# Nível de log do Baileys: silent, warn, info, debug
LOG_LEVEL=silent
